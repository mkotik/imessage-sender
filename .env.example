# Copy to .env.local (preferred; git-ignored) or .env, or ~/Library/Application Support/imessage-sender/config.env (LaunchAgent).
# Never commit a real .env.

# ---- Receiver (required) ----
IMESSAGE_INGEST_URL=https://placeholder.example.com
# Bearer token, if the receiver uses one
IMESSAGE_INGEST_TOKEN=
# Cloudflare Access service token, if the receiver sits behind Cloudflare Access
IMESSAGE_CF_ACCESS_CLIENT_ID=
IMESSAGE_CF_ACCESS_CLIENT_SECRET=

# ---- Safety switch ----
# "true" = read, parse and filter everything but never open a network connection (dry run).
IMESSAGE_DRY_RUN=false
# Set to "true" to permit a plain http:// URL (only for the local mock receiver). Default: https only.
IMESSAGE_ALLOW_INSECURE_HTTP=false

# ---- Source paths (defaults are correct for a normal macOS user) ----
IMESSAGE_CHAT_DB_PATH=~/Library/Messages/chat.db
IMESSAGE_ATTACHMENTS_DIR=~/Library/Messages/Attachments
IMESSAGE_ADDRESSBOOK_DIR=~/Library/Application Support/AddressBook

# ---- Local state & logs ----
IMESSAGE_STATE_DIR=~/Library/Application Support/imessage-sender
IMESSAGE_LOG_DIR=~/Library/Logs/imessage-sender
# debug | info | warn | error
IMESSAGE_LOG_LEVEL=info

# ---- Sync tuning ----
IMESSAGE_BATCH_SIZE=200
IMESSAGE_POLL_INTERVAL_SECONDS=30
IMESSAGE_HTTP_TIMEOUT_SECONDS=60
IMESSAGE_ATTACHMENT_HTTP_TIMEOUT_SECONDS=600
IMESSAGE_MAX_ATTACHMENT_BYTES=104857600
# Upload Apple's hidden attachments (link-preview payloads, .pluginPayloadAttachment)? Usually no.
IMESSAGE_UPLOAD_HIDDEN_ATTACHMENTS=false
# Send stickers?
IMESSAGE_UPLOAD_STICKERS=true
# Attempt contact resolution from the AddressBook store
IMESSAGE_RESOLVE_CONTACTS=true
# Send periodic heartbeats to /v1/heartbeat
IMESSAGE_HEARTBEAT=true
IMESSAGE_HEARTBEAT_INTERVAL_SECONDS=300

# ---- Privacy ----
# Extra comma-separated handles (phone/email) that must never be sent, e.g. a bank's short code.
IMESSAGE_BLOCKED_HANDLES=
# Filter every message from numeric short-code senders (3–8 digits). Strongly recommended.
IMESSAGE_FILTER_SHORTCODE_SENDERS=true
