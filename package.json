{
  "name": "imessage-sender",
  "version": "0.1.0",
  "private": true,
  "description": "Privacy-first local macOS service that streams Apple Messages history to a remote ingestion receiver, filtering OTP/authentication codes before anything leaves the Mac.",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "imessage-sender": "dist/src/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 \"dist/tests/*.test.js\"",
    "start": "node dist/src/index.js run",
    "once": "node dist/src/index.js once",
    "doctor": "node dist/src/index.js doctor",
    "status": "node dist/src/index.js status",
    "otp-check": "node dist/src/index.js otp-check",
    "mock-receiver": "node dist/tools/mock-receiver.js",
    "synthetic-db": "node dist/tools/make-synthetic-db.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  }
}
